DATABASE_URL="postgresql://postgres:password@localhost:5432/trc?schema=public"
REDIS_URL="redis://localhost:6379"
# Optional — OTP codes are stored in Postgres. Redis is only used for audit job queues.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TRC <onboarding@resend.dev>"
# Optional SMTP fallback (e.g. Gmail App Password) if Resend is unavailable
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TRC <you@gmail.com>"
JWT_SECRET="trc-secret-key-change-in-production"
JWT_REFRESH_SECRET="trc-refresh-secret-change-in-production"
PORT=4000
NODE_ENV=development
